# TELEGRAM CONFIGURATION

# Bot API token obtained from @BotFather
TELEGRAM_TOKEN="TOKEN"

# URL of the local Telegram Bot API server (required to send files larger than 50 MB)
# Set to "DEFAULT" to use official Telegram servers
TELEGRAM_LOCAL_BOT_API_URL="DEFAULT"


# RCON CONNECTION

# IP address or hostname of the server
RCON_HOST="127.0.0.1"

# RCON port (valid range: 1024 - 65535)
RCON_PORT=25575

# RCON password
RCON_PSWD="PASSWORD"


# SCHEDULE & COMMANDS

# Backup execution time and timezone offset in HH:MM:SS+TZ format
BACKUP_TIME="04:00:00+03:00"

# Backup schedule frequency. Valid options: DAILY, WEEKLY, MONTHLY
# WEEKLY runs every Monday; MONTHLY runs on the 1st of every month
BACKUP_MODE="WEEKLY"

# RCON commands executed before starting the backup (newline-separated)
CMDS_BEFORE_BACKUP="save-off
save-all
flush"

# RCON commands executed after backup creation completes (newline-separated)
CMDS_AFTER_BACKUP="save-on"


# PATHS & ARCHIVING

# Path to the game server root directory
SERVER_DIR="./server"

# Files/folders relative to SERVER_DIR to include in backup (newline-separated)
# Directories are archived recursively
BACKUP_PATHS="world
config"

# Maximum split volume chunk size for 7z archive in megabytes (MB)
BACKUP_CHUNK_SIZE="1969"

